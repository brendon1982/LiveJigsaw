{
  "name": "live-jigsaw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/domain/*.test.mjs\"",
    "test:browser": "pnpm build && node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/texture-preview.test.mjs"
  },
  "dependencies": {
    "phaser": "^4.1.0",
    "phaser4-rex-plugins": "^4.2.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}

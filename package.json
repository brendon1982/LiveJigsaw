{
  "name": "live-jigsaw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "atlas:prepare": "node scripts/prepare-atlas.mjs",
    "artists:unsplash": "node scripts/list-unsplash-artists.mjs",
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\deploy.ps1 -Distribution Debian -SshTarget paperriver.brendonpage.dev",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/domain/*.test.mjs\" \"tests/puzzles/*.test.mjs\"",
    "test:browser": "pnpm build && node tests/run-browser.mjs"
  },
  "dependencies": {
    "phaser": "^4.1.0",
    "phaser4-rex-plugins": "^4.2.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
